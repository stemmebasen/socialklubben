{
  "name": "socialklubben",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev": "node scripts/vendor.mjs && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/vendor.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "node scripts/vendor.mjs && wrangler deploy --env staging"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.129.0"
  }
}
