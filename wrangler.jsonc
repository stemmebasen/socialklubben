{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socialklubben",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": { "directory": "./public" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "SITE_NAME": "Socialklubben"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "socialklubben-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "socialklubben-staging",
      "vars": { "SITE_NAME": "Socialklubben" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "socialklubben-staging", "database_id": "SET-BY-DEPLOY", "migrations_dir": "migrations" }
      ]
    }
  }
}
